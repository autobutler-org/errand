{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>autobutler-org/renovate-config"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions pinned in the Makefile with a '# renovate:' comment",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+ := (?<currentValue>\\S+)"
      ]
    }
  ]
}
